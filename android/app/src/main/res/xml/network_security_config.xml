<?xml version="1.0" encoding="utf-8"?>
<!-- Strict network security config with dynamic-verified SSL pinning. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    
    <!-- SSL Pinning for api.myquran.com -->
    <!-- Generated 2026-05-24 from CN=myquran.com, SAN=*.myquran.com -->
