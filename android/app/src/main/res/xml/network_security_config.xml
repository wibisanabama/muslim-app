        <domain includeSubdomains="true">api.myquran.com</domain>
        <pin-set expiration="2026-06-29">
            <!-- Active Leaf Cert Pin -->
            <pin digest="SHA-256">+HFwVc++umLz88L7pVI94qDiyU6FvmQRWKPBcvUttu0=</pin>
            <!-- Intermediate CA Pin: GTS WE1 -->
            <pin digest="SHA-256">kIdp6NNEd8wsugYyyIYFsi1ylMCED3hZbSR8ZFsa/A4=</pin>
